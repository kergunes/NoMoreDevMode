<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../Directory.Build.props.user" Condition="Exists('../../Directory.Build.props.user')" />
  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.7</RimWorldVersion>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.6'">net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EarnedResurrection</AssemblyName>
    <RootNamespace>EarnedResurrection</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <OutputPath>../../$(RimWorldVersion)/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(RIMWORLD_DIR)</RimWorldDir>
    <HarmonyAssembly Condition="'$(HarmonyAssembly)' == ''">$(HARMONY_ASSEMBLY)</HarmonyAssembly>
    <HarmonyAssembly Condition="'$(RimWorldVersion)' == '1.6' And '$(Harmony16Assembly)' != ''">$(Harmony16Assembly)</HarmonyAssembly>
    <HarmonyAssembly Condition="'$(RimWorldVersion)' == '1.7' And '$(Harmony17Assembly)' != ''">$(Harmony17Assembly)</HarmonyAssembly>
  </PropertyGroup>
  <Target Name="CheckGamePath" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RimWorldVersion)' != '1.6' And '$(RimWorldVersion)' != '1.7'" Text="RimWorldVersion must be 1.6 or 1.7." />
    <Error Condition="'$(RimWorldVersion)' == '1.7' And !Exists('$(RimWorldDir)/Assembly-CSharp.dll')" Text="Set RIMWORLD_DIR or -p:RimWorldDir to the RimWorld 1.7 installation directory." />
    <Error Condition="!Exists('$(HarmonyAssembly)')" Text="Set HarmonyAssembly (or Harmony16Assembly/Harmony17Assembly) to the matching version's 0Harmony.dll." />
  </Target>
  <ItemGroup Condition="'$(RimWorldVersion)' == '1.7'">
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorldDir)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(RimWorldVersion)' == '1.6'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(HarmonyAssembly)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
