<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Independent Ideology archive layout, shared by 1.6 and 1.7.
       Skip before XML inheritance when DLC is absent; never generates a relic. -->
  <ComplexLayoutDef ParentName="AncientComplex" MayRequire="Ludeon.RimWorld.Ideology">
    <defName>ER_AncientComplex</defName>
    <threats Inherit="False">
      <SleepingMechanoids />
      <SleepingInsects />
      <Ambush />
      <CryptosleepPods />
      <Infestation />
      <FuelNode><maxPerRoom>1</maxPerRoom><selectionWeight>3</selectionWeight></FuelNode>
      <RaidTerminal><maxPerRoom>1</maxPerRoom><chancePerComplex>0.5</chancePerComplex></RaidTerminal>
    </threats>
  </ComplexLayoutDef>
</Defs>
